{
  "name": "sedmaya",
  "private": true,
  "version": "0.1.0",
  "description": "Седьмая — стратегия выживания о летающей башне над Мглой",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:data": "node tools/check-data.js",
    "export:design": "node tools/export-design.js",
    "check:design": "node tools/export-design.js --check",
    "design": "node tools/export-design.js --serve",
    "icons": "node tools/make-icons.js",
    "check:motion": "node tools/check-motion.mjs",
    "check:sound": "node tools/check-sound.mjs",
    "check:scroll": "node tools/check-scroll.mjs",
    "check:sleep": "node tools/check-tower-sleep.mjs",
    "perf": "node tools/perf-probe.mjs",
    "sounds": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/make-sounds.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:data && npm run check:design",
    "sim": "node tools/sim.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
